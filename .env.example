# Variables de entorno en Vercel (Settings → Environment Variables)

# Upstash Redis: Vercel las crea solas al conectar la base en la pestaña Storage
KV_REST_API_URL=https://xxxx.upstash.io
KV_REST_API_TOKEN=xxxx

# Clave del panel /admin (si no la pones, es 123456)
ADMIN_PASSWORD=123456

# ePayco (checkout v2 con sesión, igual que juridicosweb). La privada SOLO va aquí, nunca en el código.
EPAYCO_PUBLIC_KEY=347e56166b7cbd26c7257d8689033fba
EPAYCO_PRIVATE_KEY=tu-llave-privada
# EPAYCO_TEST=true   # solo para pruebas
